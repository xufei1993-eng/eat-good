.tab-shell {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  height: calc(92rpx + env(safe-area-inset-bottom));
  background-color: #fffdf9;
}
.tab-bar {
  height: calc(92rpx + env(safe-area-inset-bottom));
  padding: 0 12rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  border-top: 2rpx solid #e7e0d5;
  background-color: #fffdf9;
  display: flex;
  align-items: center;
}

.tab-item {
  position: relative;
  flex: 1;
  height: 86rpx;
  color: #7f8b87;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  font-size: 21rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-image {
  width: 40rpx;
  height: 40rpx;
  opacity: .4;
}

.tab-label { margin-top: 5rpx; }

.tab-item.active {
  color: #2e8f88;
  font-weight: 800;
}

.tab-item.active .tab-image {
  opacity: 1;
}

.tab-indicator {
  position: absolute;
  right: 50%;
  bottom: 0;
  width: 26rpx;
  height: 4rpx;
  transform: translateX(50%);
  border-radius: 2rpx;
  background: transparent;
}

.tab-item.active .tab-indicator { background: #2e8f88; }

