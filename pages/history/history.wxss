umn; align-items: center; justify-content: center; line-height: 1; }.day-cell[disabled] { opacity: 0; }.day-number { color: var(--ink); font-size: 22rpx; }.day-kcal { margin-top: 7rpx; color: var(--sage); font-size: 16rpx; font-weight: 700; }.day-cell.has-log { background: #f1f6f2; }.day-cell.today { border-color: #adc0b3; }.day-cell.selected { background: var(--sage); border-color: var(--sage); }.day-cell.selected .day-number,.day-cell.selected .day-kcal { color: #fff; }.selected-head { margin: 30rpx 0 14rpx; display: flex; align-items: flex-end; justify-content: space-between; }.selected-head > view { display: flex; flex-direction: column; }.selected-head > view text:first-child { color: var(--ink); font-size: 28rpx; font-weight: 800; }.selected-head > view text:last-child { margin-top: 5rpx; color: var(--muted); font-size: 20rpx; }.selected-head > text { color: var(--sage); font-size: 24rpx; font-weight: 800; }.daily-macros { margin-bottom: 12rpx; padding: 17rpx; border-radius: 8rpx; background: var(--sage-soft); display: grid; grid-template-columns: repeat(3,1fr); }.daily-macros view { display: flex; flex-direction: column; align-items: center; }.daily-macros text:first-child { color: var(--sage); font-size: 24rpx; font-weight: 800; }.daily-macros text:last-child { margin-top: 3rpx; color: var(--muted); font-size: 18rpx; }.log-row { min-height: 92rpx; margin-bottom: 10rpx; padding: 14rpx; border: 2rpx solid var(--line); border-radius: 9rpx; background: #fff; display: flex; align-items: center; box-sizing: border-box; }.log-row image,.food-placeholder { width: 64rpx; height: 64rpx; border-radius: 7rpx; flex: 0 0 auto; }.food-placeholder { background: var(--peach); color: var(--coral); font-size: 24rpx; line-height: 64rpx; text-align: center; font-weight: 800; }.log-copy { flex: 1; min-width: 0; margin-left: 13rpx; display: flex; flex-direction: column; }.log-copy text:first-child { color: var(--ink); font-size: 24rpx; font-weight: 800; }.log-copy text:last-child 