.dialog-cuisine-grid button text { margin-left: 4rpx; font-size: 22rpx; }
.dialog-cuisine-grid button.selected { border-color: var(--sage); background: var(--sage-soft); color: var(--sage); font-weight: 800; }
.prefs-page { background: #fbf7ef; color: #243541; }.prefs-topbar,.my-topbar { color: #243541; }.back,.my-topbar button { border-color: #e4ddcf; border-radius: 999rpx; background: #fffdf9; color: #2e8f88; }.prefs-intro,.onboarding-backdrop { background: #244c59; border-radius: 22rpx; }.prefs-title,.onboarding-slogan { color: #fffdf9; font-family: var(--font-ui); }.prefs-caption { color: rgba(255,253,249,.72); }.section,.my-section,.onboarding-dialog { border-color: #e4ddcf; border-radius: 18rpx; background: #fffdf9; box-shadow: 0 8rpx 22rpx rgba(91,66,43,.06); }.section-head,.section-title,.setting-title,.my-section-head text:first-child { color: #243541; }.section-hint,.setting-caption,.my-plan-mode { color: #72828c; }.taste,.allergen,.profile-mode,.onboarding-mode,.allergy-status button { border-color: #e4ddcf; border-radius: 14rpx; background: #fffdf9; }.taste.selected,.profile-mode.selected,.onboarding-mode.selected,.allergy-status button.selected { border-color: #2e8f88; background: #e6f1ea; color: #2e8f88; }.allergen.selected { border-color: #ef7860; background: #f8ddd6; color: #d95f49; }.segment-control,.gender-control { background: #e4ddcf; border-radius: 999rpx; }.segment-control button.selected,.gender-control button.selected { background: #fffdf9; color: #2e8f88; border-radius: 999rpx; }.save-button,.dialog-submit { border-radius: 999rpx; background: #2e8f88; }.allergy-notice,.pregnancy-gender-note,.profile-preview { background: #f8ddd6; border-left-color: #ef7860; color: #d95f49; }.my-profile-card { background: #244c59; border: 0; border-radius: 22rpx; color: #fffdf9; box-shadow: 0 12rpx 28rpx rgba(36,76,89,.14); }.my-profile-card .profile-kicker,.my-profile-card .my-plan-mode,.my-profile-card .avatar-hint { color: rgba(255,253,249,.72); }.my-profile-card .my-plan-title,.my-profile-card .my-metrics text:first-child { color: #fffdf9; }.my-profile-card .my-metrics { border-top-color: rgba(255,253,249,.18); }.my-profile-card .my-metrics view { background: transparent; border-radius: 0; }.my-profile-card .my-metrics text:last-child { color: rgba(255,253,249,.68); }.my-metrics view,.my-target-grid view { background: #e6f1ea; border-radius: 14rpx; }.my-pregnancy-detail { background: #f4e8c7; border-left-color: #efb84d; }
.prefs-page { padding-bottom: calc(204rpx + env(safe-area-inset-bottom)); }
.prefs-page,
.prefs-title,
.onboarding-slogan { font-family: var(--font-ui); }

/* Profile header: integrated with the page instead of a membership-style card. */
.my-profile-card {
  padding: 22rpx 10rpx 30rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #243541;
  box-shadow: none;
}
.my-profile-main { align-items: center; }
.my-avatar-button {
  width: 120rpx;
  height: 120rpx;
  border: 3rpx solid #fffdf9;
  background: #f4e8c7;
  box-shadow: 0 0 0 2rpx #e4ddcf;
}
.avatar-camera {
  right: -4rpx;
  bottom: -2rpx;
  border-color: #fbf7ef;
  background: #f4e8c7;
}
.my-profile-copy { margin-left: 26rpx; }
.my-profile-copy .profile-kicker {
  color: #72828c;
  font-size: 17rpx;
}
.my-profile-card .my-plan-title {
  margin-top: 8rpx;
  color: #243541;
  font-size: 34rpx;
}
.my-profile-card .my-plan-mode {
  margin-top: 8rpx;
  color: #53666f;
}
.my-profile-card .avatar-hint {
  margin-top: 9rpx;
  color: #8a969d;
}
.my-profile-card .my-metrics {
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx 0 2rpx;
  border-top: 1rpx solid #e7e0d5;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 0;
}
.my-profile-card .my-metrics view {
  padding: 0;
  border: 0;
  background: transparent;
  align-items: center;
}
.my-profile-card .my-metrics view + view { border-left: 0; }
.my-profile-card .my-metrics view + view::before { display: none; }
.my-profile-card .my-metrics text:first-child {
  color: #243541;
  font-size: 29rpx;
}
.my-profile-card .my-metrics text:last-child {
  margin-top: 5rpx;
  color: #72828c;
  font-size: 17rpx;
}
.my-profile-main { width: 100%; }
.my-profile-copy { flex: 1; min-width: 0; }
.profile-edit-button { flex: 0 0 auto; height: 62rpx; margin: 0 0 0 18rpx; padding: 0 18rpx; border: 2rpx solid #d9ded6; border-radius: 31rpx; background: #fffdf9; color: #2e8f88; display: flex; align-items: center; justify-content: center; line-height: 58rpx; }
.profile-edit-button::after { border: 0; }
.profile-edit-button image { width: 25rpx; height: 25rpx; margin-right: 7rpx; }
.profile-edit-button text { font-size: 19rpx; font-weight: 800; white-space: nowrap; }
.my-guest-card { margin: 24rpx 0; padding: 24rpx; border-radius: 20rpx; background: #fff; display: flex; align-items: center; box-shadow: 0 6rpx 22rpx rgba(29,56,43,.05); }
.my-guest-avatar { width: 92rpx; height: 92rpx; margin-right: 18rpx; border-radius: 50%; background: #e3f0e8; color: #2e8f88; display: flex; align-items: center; justify-content: center; font-size: 38rpx; font-weight: 800; }
.my-guest-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.my-guest-copy text:first-child { color: #26362d; font-size: 25rpx; font-weight: 800; }
.my-guest-copy text:last-child { margin-top: 8rpx; color: #829087; font-size: 18rpx; }
.profile-auth-button { flex: 0 0 auto; margin: 0; padding: 0 18rpx; height: 64rpx; border-radius: 999rpx; background: #2e8f88; color: #fff; font-size: 21rpx; line-height: 64rpx; }
