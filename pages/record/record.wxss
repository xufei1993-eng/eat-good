.photo-first-copy { min-width: 0; display: flex; align-items: center; }
.photo-first-copy > view:last-child { min-width: 0; display: flex; flex-direction: column; }
.photo-first-copy > view:last-child text:first-child { color: #173E2E; font-size: 24rpx; font-weight: 850; }
.photo-first-copy > view:last-child text:last-child { margin-top: 6rpx; color: #698074; font-size: 18rpx; }
.photo-first-icon { flex: 0 0 auto; width: 64rpx; height: 64rpx; margin-right: 15rpx; border-radius: 18rpx; background: #fff; display: flex; align-items: center; justify-content: center; }
.photo-first-icon image { width: 34rpx; height: 34rpx; }
.photo-first-empty > button { flex: 0 0 auto; height: 66rpx; margin: 0; padding: 0 20rpx; border-radius: 13rpx; background: #105C42; color: #fff; font-size: 20rpx; font-weight: 800; line-height: 66rpx; }
.photo-first-filled { position: relative; }
.photo-first-preview { width: 100%; height: 280rpx; border-radius: 17rpx; display: block; }
.photo-first-actions { position: absolute; right: 14rpx; top: 14rpx; display: flex; gap: 10rpx; }
.photo-first-actions button { height: 58rpx; margin: 0; padding: 0 18rpx; border: 2rpx solid rgba(255,255,255,.8); border-radius: 29rpx; background: rgba(255,255,255,.92); color: #24533F; font-size: 18rpx; font-weight: 800; line-height: 54rpx; box-shadow: 0 5rpx 15rpx rgba(24,45,35,.12); }
.photo-first-actions button.remove { color: #A34E43; }
.photo-first-card .vision-status,.photo-first-card .vision-error,.photo-first-card .vision-result { margin-top: 16rpx; }
.photo-first-card .vision-result { border: 0; background: #fff; }
.vision-portion { margin-top: 16rpx; padding-top: 15rpx; border-top: 2rpx solid #E2ECE5; }
.vision-portion > text { color: #516158; font-size: 19rpx; font-weight: 750; }
.vision-portion .portion-options { margin-top: 10rpx; }
.search-section-head { margin-bottom: 17rpx; display: flex; align-items: baseline; justify-content: space-between; }
.search-section-head text:first-child { color: #17231D; font-size: 25rpx; font-weight: 850; }
.search-section-head text:last-child { color: #87928B; font-size: 17rpx; }
.preference-quick-list { display: flex; gap: 10rpx; overflow-x: auto; padding-bottom: 2rpx; }
.preference-quick-list button { flex: 0 0 190rpx; min-width: 0; min-height: 92rpx; margin: 0; padding: 15rpx; border: 2rpx solid #E1E8E3; border-radius: 14rpx; background: #F7F9F7; color: #223128; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; text-align: left; line-height: 1.25; }
.preference-quick-list button text:first-child { width: 100%; overflow: hidden; font-size: 20rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.preference-quick-list button text:last-child { margin-top: 8rpx; color: #78867E; font-size: 17rpx; }
.photo-first-empty > button:active,.photo-first-actions button:active,.preference-quick-list button:active { transform: scale(.98); }
.record-page { background: #fbf7ef; color: #243541; }.record-top { color: #243541; }.record-top button { border-color: #e4ddcf; border-radius: 999rpx; background: #fffdf9; }.record-intro { background: #244c59; border-radius: 22rpx; }.record-title { color: #fffdf9; font-family: var(--font-ui); }.record-subtitle { color: rgba(255,253,249,.72); }.planned-meal,.photo-first-card,.dish-search-card,.selected-dish-card,.estimate-card,.record-extras { border-color: #e4ddcf; border-radius: 18rpx; background: #fffdf9; box-shadow: 0 8rpx 22rpx rgba(91,66,43,.06); }.planned-icon,.photo-first-icon { background: #e6f1ea; color: #2e8f88; }.dish-search input,.custom-field input { border-color: #e4ddcf; background: #fffdf9; color: #243541; border-radius: 999rpx; }.dish-result,.portion-options button { border-color: #e4ddcf; border-radius: 999rpx; background: #fffdf9; }.dish-result.selected,.portion-options button.selected { border-color: #2e8f88; background: #e6f1ea; color: #2e8f88; }.vision-result,.estimate-grid { background: #e6f1ea; border-radius: 16rpx; }.save-button,.custom-food-save { border-radius: 999rpx; background: #2e8f88; color: #fffdf9; }
.record-page,
.record-title { font-family: var(--font-ui); }
.record-mode-panel { margin: 20rpx 0; padding: 20rpx; border: 2rpx solid #e4ddcf; border-radius: 18rpx; background: #fffdf9; }
.record-mode-panel { padding: 0; border: 0; background: transparent; }
.record-mode-tabs { display: grid; grid-template-columns: 1.45fr 1fr 1fr 1fr; gap: 8rpx; }
.record-mode-tabs button { min-width: 0; height: 84rpx; margin: 0; padding: 10rpx 4rpx; border: 2rpx solid #e4ddcf; border-radius: 13rpx; background: #fffdf9; color: #718078; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.2; }
.record-mode-tabs button image { width: 30rpx; height: 30rpx; margin-bottom: 7rpx; opacity: .72; }
.record-mode-tabs button text { font-size: 17rpx; white-space: nowrap; }
.record-mode-tabs button.active { border-color: #2e8f88; background: #e6f1ea; color: #243541; }
.record-mode-tabs button.active image { opacity: 1; }
.record-mode-content { margin-bottom: 20rpx; }
.mode-empty { padding: 28rpx; border: 2rpx dashed #c9d8ce; border-radius: 16rpx; background: #f7faf7; color: #6f7d75; text-align: center; font-size: 20rpx; }
.mode-empty button { display: block; height: 58rpx; margin: 18rpx auto 0; padding: 0 22rpx; border-radius: 29rpx; background: #2e8f88; color: #fff; font-size: 18rpx; line-height: 58rpx; }
.record-top { height: 118rpx; }
.record-top > text { font-size: 40rpx; letter-spacing: 0; }
.record-top button { width: 78rpx; height: 78rpx; }
.record-top button image { width: 34rpx; height: 34rpx; }
.record-date { margin: 12rpx 4rpx 28rpx; padding: 0; border: 0; box-shadow: none; background: transparent; font-size: 28rpx; font-weight: 700; }
.record-date text:last-child { font-size: 28rpx; }
.record-mode-tabs { grid-template-columns: 1.45fr 1fr 1fr 1fr; gap: 14rpx; }
.record-mode-tabs button { height: 124rpx; padding: 16rpx 10rpx; border-radius: 24rpx; }
.record-mode-tabs button image { width: 40rpx; height: 40rpx; margin-bottom: 13rpx; }
.record-mode-tabs button text { font-size: 24rpx; font-weight: 700; }
.record-mode-tabs button.active { border-width: 4rpx; }
.photo-first-card { margin-top: 26rpx; padding: 30rpx; border-radius: 28rpx; background: #e6f1ea; }
.photo-first-empty { min-height: 470rpx; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; }
.photo-first-copy { display: flex; flex-direction: column; align-items: flex-start; }
.photo-first-copy > view:last-child text:first-child { font-size: 38rpx; }
.photo-first-copy > view:last-child text:last-child { margin-top: 10rpx; font-size: 24rpx; }
.photo-first-icon { display: none; }
.photo-stage { order: 2; height: 280rpx; margin-top: 30rpx; border: 3rpx dashed #9dc7b7; border-radius: 22rpx; background: rgba(255,255,255,.2); display: flex; flex-direction: column; align-items: center; justify-content: center; color: #2e8f88; }
.photo-stage image { width: 58rpx; height: 58rpx; opacity: .8; }
.photo-stage text { margin-top: 20rpx; color: #2e8f88; font-size: 28rpx; font-weight: 700; }
.photo-first-empty > button { order: 3; height: 92rpx; margin-top: 28rpx; border-radius: 46rpx; font-size: 30rpx; line-height: 92rpx; }
.photo-first-copy > view:last-child { order: 1; }
.record-intro {
  padding: 28rpx 30rpx 26rpx;
  box-sizing: border-box;
}
.record-title {
  line-height: 1.2;
}
.record-subtitle {
  margin-top: 10rpx;
  line-height: 1.45;
}

/* Rich image analysis */
.vision-save-state {
  margin-top: 14rpx;
  color: #2e8f88;
  font-size: 18rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.vision-save-state > view {
  min-width: 0;
  display: flex;
  align-items: center;
}
.vision-save-state > view text:first-child {
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #e6f1ea;
  font-size: 17rpx;
  line-height: 28rpx;
  text-align: center;
}
.vision-save-state > view text:last-child {
  min-width: 0;
  line-height: 1.4;
}
.vision-save-state button {
  flex: 0 0 auto;
  height: 52rpx;
  margin: 0 0 0 14rpx;
  padding: 0 16rpx;
  border: 2rpx solid #c9ded6;
  border-radius: 999rpx;
  background: #fffdf9;
  color: #2e8f88;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 48rpx;
}
.vision-nutrients-title {
  display: block;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e7e0d5;
  color: #243541;
  font-size: 22rpx;
  font-weight: 800;
}
.vision-nutrients {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rpx;
  background: #e7e0d5;
}
.vision-nutrients view {
  min-width: 0;
  min-height: 86rpx;
  padding: 13rpx 5rpx;
  box-sizing: border-box;
  background: #f8faf7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.vision-nutrients text:first-child {
  color: #72828c;
  font-size: 16rpx;
}
.vision-nutrients text:last-child {
  margin-top: 6rpx;
  color: #243541;
  font-size: 20rpx;
  font-weight: 800;
}
.vision-advice {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #2e8f88;
  background: #eef7f4;
  display: flex;
  flex-direction: column;
}
.vision-advice text:first-child {
  color: #243541;
  font-size: 21rpx;
  font-weight: 800;
}
.vision-advice text:last-child {
  margin-top: 8rpx;
  color: #53666f;
  font-size: 19rpx;
  line-height: 1.6;
}
